# Night City Services Environment Variables

# Temporal server address (default: localhost:7233)
TEMPORAL_ADDRESS=localhost:7233

# ═══════════════════════════════════════════════════════════════════
# AI Model Provider Keys
# At least one is required for the NetWatch AI Agent
# Keys are ONLY needed by the worker process, not the client/frontend
# ═══════════════════════════════════════════════════════════════════

# OpenAI API Key (for GPT-4o models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API Key (for Claude models)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Web server port (default: 3000)
PORT=3000
