# Night City Services Environment Variables

# Temporal server address (default: localhost:7233)
TEMPORAL_ADDRESS=localhost:7233

# OpenAI API Key (required for NetWatch AI Agent)
# Get your key at: https://platform.openai.com/api-keys
# This key is ONLY needed by the worker process, not the client/frontend
OPENAI_API_KEY=sk-your-api-key-here

# Web server port (default: 3000)
PORT=3000
